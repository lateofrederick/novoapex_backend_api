DOMAIN=novoapex.duckdns.org

POSTGRES_PASSWORD=change-me-strong
REDIS_PASSWORD=change-me-strong
JWT_SECRET=change-me-32-characters-minimum!!

# Queue dashboard (/admin/queues) basic auth
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# LLM providers
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# SMTP (Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (optional; unset = no error reporting, tracing, profiling or log forwarding)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Share of requests/tasks traced, and share of traced ones profiled.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=1.0
# true sends customer phone numbers / conversation ids to Sentry unscrubbed.
SENTRY_SEND_PII=false

LOG_LEVEL=info

# Worker parallelism across all queues; keep WORKER_DATABASE_POOL_MAX >= this.
WORKER_CONCURRENCY=10
WORKER_DATABASE_POOL_MAX=10

# Expose Swagger UI (/api-docs) in production (e.g. staging). Always on outside production.
ENABLE_SWAGGER=false
